        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/{{profileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles",
            "{{profileId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anca\",\n  \"surname\": \"Pop\",\n  \"email\": \"ana@example.com\",\n  \"phone\": \"+40 712 345 678\",\n  \"skills\": [\n    \"HTML\",\n    \"JavaScript\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Name updated\", function () { pm.expect(pm.response.json().name).to.eql(\"Anca\"); });"
            ]
          }
        }
      ]
    },
