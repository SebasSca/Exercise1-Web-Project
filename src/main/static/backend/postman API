{
  "info": {
    "name": "Profiles API",
    "description": "CRUD tests for the Flask + SQLite profiles API. Run the whole collection in order with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. List profiles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Body is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/profiles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"surname\": \"Pop\",\n  \"email\": \"ana@example.com\",\n  \"phone\": \"+40 712 345 678\",\n  \"skills\": [\n    \"HTML\",\n    \"JavaScript\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Saves the new id into the profileId collection variable."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "const j = pm.response.json();\npm.test(\"Has id\", function () { pm.expect(j.id).to.be.a(\"number\"); });\npm.collectionVariables.set(\"profileId\", j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get profile by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/{{profileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "profiles",
            "{{profileId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Skills is an array\", function () { pm.expect(pm.response.json().skills).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Update profile",
      "request": {
